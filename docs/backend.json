{
    "entities": {
        "User": {
            "title": "User",
            "description": "Represents a user of the application.",
            "type": "object",
            "properties": {
                "uid": {
                    "type": "string",
                    "description": "The user's unique ID."
                },
                "email": {
                    "type": "string",
                    "format": "email",
                    "description": "The user's email address."
                },
                "displayName": {
                    "type": "string",
                    "description": "The user's display name."
                },
                "photoURL": {
                    "type": "string",
                    "format": "uri",
                    "description": "The URL of the user's profile picture."
                },
                "role": {
                    "type": "string",
                    "enum": ["farmer", "buyer"],
                    "description": "The user's role."
                }
            },
            "required": ["uid", "email", "role"]
        },
        "Listing": {
            "title": "Listing",
            "description": "Represents a crop listing in the marketplace.",
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "The unique ID of the listing."
                },
                "farmerId": {
                    "type": "string",
                    "description": "The ID of the farmer who created the listing."
                },
                "name": {
                    "type": "string",
                    "description": "The name of the crop."
                },
                "pricePerKg": {
                    "type": "number",
                    "description": "The price per kilogram."
                },
                "quantityKg": {
                    "type": "number",
                    "description": "The available quantity in kilograms."
                },
                "imageUrl": {
                    "type": "string",
                    "format": "uri",
                    "description": "The URL of the crop image."
                },
                "createdAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "The timestamp when the listing was created."
                }
            },
            "required": ["farmerId", "name", "pricePerKg", "quantityKg", "imageUrl", "createdAt"]
        },
        "Chat": {
            "title": "Chat",
            "description": "Represents a negotiation chat between a buyer and a seller.",
            "type": "object",
            "properties": {
                "id": { "type": "string", "description": "The unique ID of the chat." },
                "listingId": { "type": "string", "description": "The ID of the listing this chat is about." },
                "listingName": { "type": "string", "description": "The name of the listing." },
                "participants": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "An array of user UIDs participating in the chat."
                },
                "lastMessage": {
                    "type": "object",
                    "properties": {
                        "text": { "type": "string" },
                        "senderId": { "type": "string" },
                        "timestamp": { "type": "string", "format": "date-time" }
                    }
                },
                "unreadBy": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "An array of user UIDs who have unread messages in this chat."
                },
                "updatedAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "The timestamp when the chat was last updated."
                }
            },
            "required": ["listingId", "participants", "updatedAt", "listingName"]
        },
        "ChatMessage": {
            "title": "Chat Message",
            "description": "Represents a message in a negotiation chat.",
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "description": "The unique ID of the message."
                },
                "chatId": {
                    "type": "string",
                    "description": "The ID of the chat this message belongs to."
                },
                "senderId": {
                    "type": "string",
                    "description": "The ID of the user who sent the message."
                },
                "text": {
                    "type": "string",
                    "description": "The content of the message."
                },
                "timestamp": {
                    "type": "string",
                    "format": "date-time",
                    "description": "The timestamp when the message was sent."
                }
            },
            "required": ["chatId", "senderId", "text", "timestamp"]
        }
    },
    "auth": {
        "providers": ["email"]
    },
    "firestore": {
        "/users/{userId}": {
            "schema": {
                "$ref": "#/entities/User"
            },
            "description": "Stores user profile information."
        },
        "/listings/{listingId}": {
            "schema": {
                "$ref": "#/entities/Listing"
            },
            "description": "Stores all crop listings."
        },
        "/chats/{chatId}": {
            "schema": {
                "$ref": "#/entities/Chat"
            },
            "description": "Stores metadata for a single chat session."
        },
        "/chats/{chatId}/messages/{messageId}": {
            "schema": {
                "$ref": "#/entities/ChatMessage"
            },
            "description": "Stores messages for a specific chat."
        }
    }
}
